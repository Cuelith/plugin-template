{
  "name": "plugin-template",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.8.1",
  "description": "Modello per i moduli di Cuelith, con il modulo d'esempio hello-panel: un pannello e un comando che gira nel suo processo.",
  "scripts": {
    "build": "vite build && vite build --config vite.main.config.ts && node scripts/package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --write .",
    "keys": "node scripts/keys.mjs",
    "sign": "node scripts/sign.mjs",
    "conformance": "node scripts/conformance.mjs"
  },
  "dependencies": {
    "@cuelith/panel": "0.7.0",
    "@cuelith/protocol": "1.15.0",
    "@cuelith/sdk": "0.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "fflate": "0.8.3",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
