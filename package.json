{
  "name": "plugin-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.8.1",
  "description": "Modello per i moduli di Cuelith, con il modulo d'esempio hello-panel: un pannello e un comando che gira nel suo processo.",
  "scripts": {
    "build": "vite build && vite build --config vite.main.config.ts && node scripts/package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@cuelith/panel": "link:../cuelith-sdk/packages/panel",
    "@cuelith/protocol": "link:../cuelith-sdk/packages/protocol",
    "@cuelith/sdk": "link:../cuelith-sdk/packages/sdk"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "fflate": "0.8.3",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
