{
  "$schema": "https://cuelith.github.io/cuelith-sdk/schema/plugin-1.json",
  "id": "cuelith.hello",
  "name": "Ciao",
  "description": "Modulo d'esempio: un pannello e un comando che gira nel suo processo. Punto di partenza per scrivere moduli.",
  "version": "0.2.0",
  "publisher": "Cuelith",
  "license": "Apache-2.0",
  "repository": "https://github.com/Cuelith/plugin-template",
  "family": "function",
  "engines": {
    "cuelith": ">=0.1.0 <1.0.0",
    "protocol": "^1.9.0"
  },
  "runtime": {
    "type": "node",
    "entry": "dist/main.mjs"
  },
  "icon": "icon.svg",
  "ui": {
    "entry": "dist/ui/index.html"
  },
  "permissions": ["storage"],
  "resources": {
    "memoryMB": {
      "idle": 45,
      "peak": 100
    },
    "cpuPercent": {
      "idle": 0.5,
      "peak": 10
    }
  },
  "dependencies": {},
  "extends": [],
  "provides": [],
  "contributes": {
    "panels": [
      {
        "id": "hello",
        "title": "cuelith.hello.panel",
        "placement": "side"
      }
    ],
    "commands": [
      {
        "id": "greet",
        "title": "cuelith.hello.command.greet"
      },
      {
        "id": "count",
        "title": "cuelith.hello.command.count"
      }
    ],
    "events": ["greeted"],
    "locales": [
      {
        "lang": "it",
        "file": "locales/it.json"
      }
    ]
  }
}
